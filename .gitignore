# ==============================================================================
# 🛡️ PrivacyShield Git Ignore
# ==============================================================================

# Environment variables & secrets (CRITICAL: Never commit credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Keep environment template tracked
!.env.example
!backend/.env.example
!frontend/.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Local SQLite databases & transaction logs
backend/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Build outputs
dist/
frontend/dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & IDE configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

